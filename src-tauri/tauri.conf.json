{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutCut",
  "version": "0.1.0",
  "identifier": "com.aiautovideo.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CutCut",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420 https://mczkvdlclkzjcxdjlelj.supabase.co https://generativelanguage.googleapis.com; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UNCONFIGURED_MINISIGN_PUBLIC_KEY",
      "endpoints": ["https://releases.cutcut.app/{{target}}-{{arch}}.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "binaries/whisper/*.dll": "."
    },
    "externalBin": ["ffmpeg", "ffprobe", "whisper"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
